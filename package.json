{
  "name": "aerocraft-bear-forgestack",
  "displayName": "AeroCraft & Bear (ForgeStack)",
  "description": "AeroCraft class completions from the real utility catalog, hovers with color swatches, and Bear JSX hints. Optional Tailwind-style alias mode.",
  "icon": "images/aerocraft-brand.png",
  "version": "0.1.2",
  "publisher": "forgestack",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yaghobieh/aero-craft-plugin"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:css",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "workspaceContains:**/aerocraft.config.*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "AeroCraft & Bear",
      "properties": {
        "aerocraft.enableCompletions": {
          "type": "boolean",
          "default": true,
          "description": "Suggest AeroCraft classes in class/className/@apply, Bear JSX props on supported tags, and enable related hovers."
        },
        "aerocraft.utilityAliasMode": {
          "type": "boolean",
          "default": false,
          "description": "Also suggest parallel utility-style names (e.g. flex flex-col) next to AeroCraft shortcuts for teams mixing stacks."
        },
        "bear.enableComponentSnippets": {
          "type": "boolean",
          "default": true,
          "description": "Register Bear import and JSX snippets in TypeScript React."
        }
      }
    },
    "snippets": [
      {
        "language": "typescriptreact",
        "path": "./snippets/bear.json"
      }
    ]
  },
  "scripts": {
    "postinstall": "tsc -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "@forgedevstack/aerocraft": "^1.0.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.7.3"
  }
}
